# MongoDB Connection String (Replace with your MongoDB Atlas Connection URI if using Cloud MongoDB)
# Example: MONGO_DETAILS=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/food_freshness?retryWrites=true&w=majority
MONGO_DETAILS=mongodb://localhost:27017/food_freshness

# JWT Secret Key for Session Authentication (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP Email Configuration for sending real OTP emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=your_email@gmail.com

# Optional overrides (defaults work locally):
# MODEL_PATH=
# CLASS_MAPPING_PATH=
# UPLOAD_DIR=

GEMINI_API_KEY=your_gemini_api_key_here
# Alternative environment variable name also supported:
# GOOGLE_API_KEY=your_google_api_key_here