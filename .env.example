# MongoDB Connection String (Replace with your MongoDB Atlas Connection URI if using Cloud MongoDB)
# Example: MONGO_DETAILS=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/food_freshness?retryWrites=true&w=majority
MONGO_DETAILS=mongodb://localhost:27017/food_freshness

